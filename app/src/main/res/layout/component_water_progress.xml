<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <com.reynanfc.hydrotrack.ui.widget.WaterProgressView
        android:id="@+id/water_progress_view"
        android:layout_width="304dp"
        android:layout_height="304dp"
        app:alertColor="@color/hydro_goal_reached"
        app:maxValue="2000"
        app:progressColor="@color/hydro_primary"
        app:textColor="@color/hydro_card_foreground" />

    <TextView
        android:id="@+id/text_water_progress_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:text="@string/water_progress_default_message"
        android:textColor="@color/hydro_muted_foreground"
        android:textSize="14sp"
        tools:text="Faltam 640 ml para sua meta diária." />

</LinearLayout>
